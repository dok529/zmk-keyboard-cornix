#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 280
#define HM_TAPPING_REPEAT 210

// require-prior-idle-ms is what actually resolves most taps instantly (a
// tap right after typing normally is assumed to be a tap, not a hold) --
// per urob's own formula (require-prior-idle-ms >= 10500/WPM), 70ms only
// covers >150 WPM. 150ms covers up to ~70 WPM; raise further if still slow.
#define HM_PRIOR_IDLE 150
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH2 LH1 LH0 RH0 RH1 RH2
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <175>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Positional Homerow mods for shift.
        // (previously used a shorter "fast" tapping term than hm_l/hm_r; a
        // *shorter* term only makes shift misfire as a hold more often and
        // doesn't reduce tap latency -- require-prior-idle-ms is what does
        // that -- so this now shares the same term as hm_l/hm_r.)

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;

            // for quick tapping; shift+~

            hold-trigger-on-release;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <175>;
            // this wraps SPACE/TAB on the thumb keys, so a missing
            // require-prior-idle-ms meant every space/tab was withheld
            // until release -- add it so fast typing resolves instantly.
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        // Grave/Escape: tap for Escape, tap with Shift/Gui held for `~
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_LSFT|MOD_RSFT)>;
        };

        // macOS Colemak umlauts: tap for lowercase, tap with Shift held for
        // the capital. mod-morph masks the real (explicit) Shift before
        // invoking the morph branch, so the Option+<dead-key> step below
        // fires unshifted; Shift for the capital is then reapplied only to
        // the final letter as an *implicit* modifier via LS(), which the
        // masking does not touch. See zmuml below for the actual sequence.
        zmae: zm_ae {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&zmuml A>, <&zmuml LS(A)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        zmoe: zm_oe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&zmuml SEMI>, <&zmuml LS(SEMI)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        zmue: zm_ue {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&zmuml I>, <&zmuml LS(I)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // Option+I is macOS's diaeresis dead key *as remapped by the
        // Colemak input source* (HID I is where Colemak's "u" sits, and
        // macOS's Option-layer follows the remapped letters). Tapping a
        // vowel afterwards composes ae/oe/ue; the parameter carries which
        // vowel keycode to tap (plain for lowercase, LS(x) for capital,
        // via zmae/zmoe/zmue above).
        zmuml: zmuml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp I>
                , <&macro_release &kp LALT>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                ;
        };

        // ported from miryoku.vil macro M4 (M0-M3 dropped: M0 was only used by
        // now-dropped tap-dances; M1-M3 were the same Option+I umlaut pattern,
        // replaced above by zmae/zmoe/zmue so Shift produces capitals too)
        zm4: zm4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp N>
                , <&macro_release &kp LGUI>
                , <&macro_release &kp LALT>
                ;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Adjust (layer 3) is reached identically from Base (Windows) and
        // win_layer (macOS mode), so it can't know which OS it's for. When
        // win_layer + Adjust are both active, additionally activate
        // mac_adjust_layer on top: it overrides only Home/End with the
        // macOS-correct Cmd+Left/Right (raw Home/End scroll the viewport on
        // macOS instead of moving the cursor) and is &trans everywhere else,
        // falling through to Adjust's shared bindings.
        mac_adjust {
            if-layers = <1 3>;
            then-layer = <8>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cb_cv {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
            layers = <0 1>;
        };

        cb_we {
            bindings = <&kp ESC>;
            key-positions = <2 3>;
            layers = <0 1>;
        };

        cb_mcomma {
            bindings = <&kp ENTER>;
            key-positions = <33 34>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // The following 8 layers are a direct port of miryoku.vil (Vial/QMK keymap for
        // this board). Vial's original 10-layer keymap is reduced to 8: the last two
        // layers (indices 8/9) were dropped per request, and their only entry points
        // (TG(8), MO(9)) become &none. QMK tap-dances are reduced to their native
        // ZMK-compatible tap+hold behavior; double-tap / double-tap-hold actions are
        // not reproduced (ZMK has no built-in equivalent). USER00/USER01/USER02/
        // USER05/USER06 (custom QMK user keycodes) have no recoverable definition in
        // the .vil file; they are best-effort-mapped to Bluetooth profile selection
        // based on their position (far-left column of the Adjust layer, matching the
        // BT_SEL pattern used elsewhere) -- verify against the original QMK
        // process_record_user() if available.

        default_layer {
            display-name = "Base";

            bindings = <
&gresc     &kp Q         &kp W         &kp E          &kp R                &kp T          &kp Y      &kp U          &kp I          &kp O         &kp SQT               &kp BSPC
&kp TAB    &hm_l LALT A  &hm_l LALT S  &hm_l LCTRL D  &hm_shift_l LSHFT F  &kp G          &kp H      &hm_shift_r RSHFT J  &hm_r RCTRL K  &hm_r RALT L  &kp SEMI              &kp ENTER
&kp LSHFT  &kp Z         &kp X         &kp C          &kp V                &kp B  &zm4    &tog 1     &kp N      &kp M          &kp COMMA      &kp DOT       &kp FSLH              &kp BSLH
&kp LCTRL  &kp LGUI      &kp LALT      &mo 2          &hm LCTRL SPACE      &hm LGUI TAB   &lt 5 LSHFT  &lt 3 BSPC  &lt 7 DELETE  &kp HOME      &kp LG(U)             &kp END
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp RIGHT LEFT>;
        };

        win_layer {
            display-name = "Windows";

            bindings = <
&trans     &trans        &trans    &trans        &trans           &trans        &trans  &trans  &trans        &trans         &trans         &trans
&trans     &hm_l LGUI A  &trans    &trans        &trans           &trans        &trans  &trans  &trans        &trans         &trans         &trans
&trans     &trans        &trans    &trans        &trans           &trans  &trans  &tog 0  &trans        &trans         &trans        &trans  &trans  &trans
&kp LGUI   &kp LALT      &kp LCTRL &lt 4 LS(N6)  &hm LGUI SPACE   &hm LGUI TAB  &trans  &trans  &trans        &kp LG(LEFT)  &kp LC(LG(Q))  &kp LG(RIGHT)
            >;
        };

        media_layer {
            display-name = "Media";

            bindings = <
&trans  &kp C_AC_REFRESH  &kp C_AC_FORWARD  &kp C_AC_BACK  &kp C_VOL_UP  &kp LG(U)   &trans  &trans  &kp RA(O)  &trans  &trans  &trans
&trans  &kp RA(Q)         &trans            &kp RA(D)      &kp C_VOL_DN  &zm4        &kp F12  &trans  &trans  &trans  &kp RA(P)  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans  &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &kp ENTER        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";

            bindings = <
&bt BT_CLR    &bootloader  &none     &none     &none     &none   &kp CAPS    &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp INS    &none
&bt BT_SEL 0  &kp LGUI     &kp LALT  &kp LCTRL &kp LSHFT &none   &kp HOME    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
&bt BT_SEL 1  &none  &none  &none  &none  &none  &kp C_MUTE  &mkp MB3  &caps_word  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &none
&bt BT_SEL 2  &bt BT_SEL 3  &bootloader  &trans  &trans  &trans   &trans   &trans     &trans     &none      &none      &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        mix_layer {
            display-name = "Mix";

            bindings = <
&trans  &trans  &kp LG(RBKT)  &kp LG(LBKT)  &kp C_VOL_UP  &kp LC(LG(Q))  &trans  &trans  &zmue   &trans  &trans  &trans
&trans  &zmae   &trans        &kp LA(D)     &kp C_VOL_DN  &kp LS(LG(M))  &trans  &trans  &trans  &trans  &zmoe   &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp C_MUTE  &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &trans  &trans  &trans  &trans  &kp ENTER        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num_layer {
            display-name = "Num";

            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT   &trans  &trans     &trans     &trans     &trans    &trans
&trans  &kp P      &kp N4  &kp N5  &kp N6  &kp EQUAL  &trans  &kp RSHFT  &kp RCTRL  &kp RALT   &kp RGUI  &trans
&trans  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH  &kp C_MUTE  &mkp MB3  &tog 5  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp DOT  &kp N0  &kp MINUS        &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        num2_layer {
            display-name = "Num2";

            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans   &kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT   &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans   &kp EQUAL &kp N4  &kp N5  &kp N6  &kp N0     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &mkp MB3  &kp P  &kp N1  &kp N2  &kp N3  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &tog 6  &trans        &kp COMMA  &kp DOT  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        sym_layer {
            display-name = "Sym";

            bindings = <
&trans  &kp LS(LBKT)   &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(RBKT)   &trans  &trans     &trans     &trans     &trans    &trans
&trans  &kp LS(P)      &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(EQUAL)  &trans  &kp RSHFT  &kp RCTRL  &kp RALT   &kp RGUI  &trans
&trans  &kp LS(GRAVE)  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(BSLH)  &kp C_MUTE  &mkp MB3  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)        &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_DN PG_UP>;
        };

        mac_adjust_layer {
            // Activated automatically (see conditional_layers above) on top
            // of Adjust whenever win_layer (macOS mode) is also active.
            // Only overrides Home/End; everything else is &trans and falls
            // through to Adjust.
            display-name = "AdjMac";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LEFT)  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LEFT)  &trans  &trans  &kp LG(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
